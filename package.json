{
  "name": "selenium-js-cucumber",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:headless": "HEADLESS=true cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check 'features/**/*.ts' 'pages/**/*.ts' 'modules/**/*.ts' 'utils/**/*.ts' 'support/**/*.ts' 'tests/**/*.ts' '*.ts'",
    "format:write": "prettier --write 'features/**/*.ts' 'pages/**/*.ts' 'modules/**/*.ts' 'utils/**/*.ts' 'support/**/*.ts' 'tests/**/*.ts' '*.ts'",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "report": "npx allure generate allure-results --clean -o allure-report",
    "report:open": "npx allure open allure-report",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "allure-commandline": "^2.0.0",
    "allure-cucumberjs": "^3.0.0",
    "chai": "^4.5.0",
    "dotenv": "^18.0.10",
    "selenium-webdriver": "^4.51.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^9.39.5",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
